# Life Planner 后端环境变量
# 复制为 .env 并填写；除密钥外均有开发默认值。

# ---- 运行 ----
DEBUG=false
# 数据库连接（默认本地 SQLite）
DATABASE_URL=sqlite:///./life_planner.db

# ---- 认证（生产必须修改！生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"）----
SECRET_KEY=
JWT_SECRET_KEY=
# 访问令牌有效期（分钟），默认 1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 信任边界中间件签名密钥（app/middleware/trust_bd.py）
LIFE_PLANNER_SECRET=

# ---- AI（AI 规划功能必需）----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- 可选：信任边界审计路径（trust_bd 中间件）----
# B4_USER_KEY_PATH=/tmp/b4_user.key
# B4_AUDIT_DB=/tmp/life_planner_b4_audit.db
